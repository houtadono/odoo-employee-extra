<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_hr_employee" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.hr_employee</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="25"/>
            <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@data-string='Employees']" position="inside">
                        <h2>Employee Extra</h2>
                        <div class="row mt16 o_settings_container" name="hr_employee_setting_container">
                            <div class="col-xs-12 col-md-6 o_setting_box">
                                <div>
                                    <div class="o_setting_left_pane">
                                        <field name="hr_employee_is_show_cer_if_not_skill"/>
                                    </div>
                                    <div class="o_setting_right_pane">
                                        <label for="hr_employee_is_show_cer_if_not_skill"/>
                                        <div class="text-muted">
                                            Setting show cer if not skill?
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="default_years_of_experience"/>
                                    <br/>
                                    <field name="default_years_of_experience"/>
                                </div>
                            </div>
                        </div>
<!--                    </div>-->
                </xpath>
            </field>
        </record>

        <!--        <record id="action_hr_employee_configuration" model="ir.actions.act_window">-->
